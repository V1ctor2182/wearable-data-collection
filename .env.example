GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REDIRECT_URI=http://localhost:8000/oauth/googlefit/callback

# WHOOP
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
